#!/bin/bash
# kb — Project Knowledge Base CLI
# Stored in: ~/.claude/skills/kb/scripts/kb
# Data dir:  docs/project-history/ (in project repo)
#
# Usage: kb <command> [args]
#
# Session lifecycle:
#   start               Restore context: status + latest session + cold start
#   save                 Save session progress (interactive — gathers git data)
#   end                  Alias for save
#
# Queries:
#   status               Project status summary
#   sessions [N]         List sessions or show session N
#   decisions            List all decisions
#   bugs [--open]        List bugs (optionally filter open only)
#   constraints          List environmental constraints
#   dead-ends            List failed approaches
#   search <term>        Search across all categories
#
# Maintenance:
#   rebuild              Regenerate all INDEX.md files from source
#   init                 First-time setup — create directory structure
#   help                 Show this help

set -e

# Find the project's knowledge base directory
find_kb_dir() {
  # Walk up from cwd looking for docs/project-history/
  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    if [ -d "$dir/docs/project-history/sessions" ]; then
      echo "$dir/docs/project-history"
      return 0
    fi
    dir=$(dirname "$dir")
  done
  echo ""
  return 1
}

KB_DIR=$(find_kb_dir || true)
if [ -z "$KB_DIR" ] && [ "${1:-}" != "init" ]; then
  # Auto-init for save/end commands instead of failing
  if [ "${1:-}" = "save" ] || [ "${1:-}" = "end" ]; then
    GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")
    KB_DIR="$GIT_ROOT/docs/project-history"
    echo "No knowledge base found. Auto-creating at: $KB_DIR"
    mkdir -p "$KB_DIR"/{sessions,decisions,bugs,constraints,dead-ends}
    # Generate empty INDEX files
    for category_dir in sessions decisions bugs; do
      cat > "$KB_DIR/$category_dir/INDEX.md" << IDXEOF
# $(echo "$category_dir" | sed 's/.*/\u&/')

| ID | Date | Status | Title |
|----|------|--------|-------|

_Generated by \`kb rebuild\` — do not edit manually._
IDXEOF
    done
    cat > "$KB_DIR/INDEX.md" << ROOTEOF
# Project History

- [\`sessions/\`](sessions/INDEX.md) — Chronological session logs
- [\`decisions/\`](decisions/INDEX.md) — Architecture decision records
- [\`bugs/\`](bugs/INDEX.md) — Bug reports and fixes
- [\`constraints/\`](constraints/) — Environmental constraints
- [\`dead-ends/\`](dead-ends/) — Failed approaches (do not retry)

_Generated by \`kb rebuild\`._
ROOTEOF
    echo "Knowledge base initialized."
    echo ""
  else
    echo "No knowledge base found. Run: kb init"
    exit 1
  fi
fi

# Parse YAML front matter value from a file
fm_val() {
  local file="$1" key="$2"
  sed -n '/^---$/,/^---$/p' "$file" 2>/dev/null | grep "^${key}:" | sed "s/^${key}:[[:space:]]*//" | tr -d '"'
}

# List entries from a category directory
list_category() {
  local dir="$1" filter_key="$2" filter_val="$3"
  for f in "$KB_DIR/$dir"/[0-9A-Z]*.md; do
    [ -f "$f" ] || continue
    id=$(fm_val "$f" "id")
    title=$(fm_val "$f" "title")
    status=$(fm_val "$f" "status")
    date=$(fm_val "$f" "date")
    printf "%-12s %-10s %-8s %s\n" "$id" "$date" "$status" "$title"
    if [ -n "$filter_key" ] && [ -n "$filter_val" ]; then
      val=$(fm_val "$f" "$filter_key")
      echo "$val" | grep -q "$filter_val" || continue
    fi
  done
}

# Generate INDEX.md for a category
gen_index() {
  local dir="$1" title="$2"
  local idx="$KB_DIR/$dir/INDEX.md"
  {
    echo "# $title"
    echo ""
    echo "| ID | Date | Status | Title |"
    echo "|----|------|--------|-------|"
    for f in "$KB_DIR/$dir"/[0-9A-Z]*.md; do
      [ -f "$f" ] || continue
      id=$(fm_val "$f" "id")
      title_v=$(fm_val "$f" "title")
      status=$(fm_val "$f" "status")
      date=$(fm_val "$f" "date")
      fname=$(basename "$f")
      echo "| $id | $date | $status | [$title_v]($fname) |"
    done
    echo ""
    echo "_Generated by \`kb rebuild\` — do not edit manually._"
  } > "$idx"
}

# Get next session number
next_session_num() {
  local latest=$(ls "$KB_DIR/sessions"/[0-9]*.md 2>/dev/null | sort | tail -1)
  if [ -z "$latest" ]; then
    echo "001"
  else
    local num=$(fm_val "$latest" "id" | sed 's/^0*//')
    printf "%03d" $((num + 1))
  fi
}

case "${1:-help}" in

  # === SESSION LIFECYCLE ===

  start)
    echo "=== Restoring Context ==="
    echo ""
    # Status
    "$0" status
    echo ""
    # Open bugs
    open_bugs=$(ls "$KB_DIR/bugs"/[0-9A-Z]*.md 2>/dev/null | while read f; do
      [ "$(fm_val "$f" "status")" = "open" ] && echo "$f"
    done)
    if [ -n "$open_bugs" ]; then
      echo "=== Open Bugs ==="
      echo "$open_bugs" | while read f; do
        echo "  - $(fm_val "$f" "id"): $(fm_val "$f" "title")"
      done
      echo ""
    fi
    # Dead ends reminder
    de_count=$(ls "$KB_DIR/dead-ends"/*.md 2>/dev/null | grep -v INDEX | wc -l | tr -d ' ')
    if [ "$de_count" -gt 0 ]; then
      echo "=== Dead Ends ($de_count) — DO NOT RETRY ==="
      for f in "$KB_DIR/dead-ends"/*.md; do
        [ -f "$f" ] && [ "$(basename "$f")" != "INDEX.md" ] || continue
        echo "  - $(fm_val "$f" "title")"
      done
      echo ""
    fi
    # Latest session cold start
    latest=$(ls "$KB_DIR/sessions"/[0-9]*.md 2>/dev/null | sort | tail -1)
    if [ -n "$latest" ]; then
      echo "=== Cold Start ==="
      # Extract the blockquote cold start line
      grep "^>" "$latest" | head -1
      echo ""
      echo "Full session: $latest"
    fi
    ;;

  save|end)
    echo "=== Saving Session Progress ==="
    NUM=$(next_session_num)
    echo "Next session number: $NUM"
    echo ""

    # Gather git info
    BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
    RECENT=$(git log --oneline -10 2>/dev/null || echo "no commits")
    echo "Branch: $BRANCH"
    echo "Recent commits:"
    echo "$RECENT"
    echo ""
    echo "--- Session entry template ---"
    echo "Create: $KB_DIR/sessions/${NUM}-SLUG.md"
    echo ""
    cat << TEMPLATE
---
id: "$NUM"
title: "FILL: one-line summary"
date: $(date +%Y-%m-%d)
status: complete
tags: [FILL]
commits: "FILL"
commit_count: FILL
---

# Session $NUM — FILL: Title

**Status:** FILL: 2-3 sentences.

## Completed
- [x] FILL with \`file/path\`
- **Verification:** FILL

## Next Steps
1. **IMMEDIATE:** FILL
2. FILL

> **Cold start:** FILL: one sentence, one action, one file path.
TEMPLATE
    echo ""
    echo "After creating the entry, also create any:"
    echo "  - decisions/ entries (DEC-NNN-slug.md)"
    echo "  - bugs/ entries (BUG-NNN-slug.md)"
    echo "  - dead-ends/ entries (slug.md) — MANDATORY if anything failed"
    echo ""
    echo "Then run: kb rebuild && kb status"
    ;;

  # === QUERIES ===

  status)
    echo "=== Knowledge Base ==="
    echo ""
    kb_sessions=$(ls "$KB_DIR/sessions"/[0-9]*.md 2>/dev/null | wc -l | tr -d ' ')
    kb_decisions=$(ls "$KB_DIR/decisions"/[0-9A-Z]*.md 2>/dev/null | wc -l | tr -d ' ')
    kb_bugs=$(ls "$KB_DIR/bugs"/[0-9A-Z]*.md 2>/dev/null | wc -l | tr -d ' ')
    kb_constraints=$(ls "$KB_DIR/constraints"/*.md 2>/dev/null | grep -v INDEX | wc -l | tr -d ' ')
    kb_deadends=$(ls "$KB_DIR/dead-ends"/*.md 2>/dev/null | grep -v INDEX | wc -l | tr -d ' ')
    echo "Sessions:    $kb_sessions"
    echo "Decisions:   $kb_decisions"
    echo "Bugs:        $kb_bugs"
    echo "Constraints: $kb_constraints"
    echo "Dead ends:   $kb_deadends"
    if [ "$kb_sessions" -gt 0 ]; then
      latest=$(ls "$KB_DIR/sessions"/[0-9]*.md 2>/dev/null | sort | tail -1)
      echo ""
      echo "Latest: $(fm_val "$latest" "id") — $(fm_val "$latest" "title")"
      echo "Date:   $(fm_val "$latest" "date")"
      echo "Status: $(fm_val "$latest" "status")"
    fi
    ;;

  sessions)
    if [ -n "$2" ]; then
      f=$(ls "$KB_DIR/sessions"/$2*.md 2>/dev/null | head -1)
      [ -f "$f" ] && cat "$f" || echo "Session $2 not found"
    else
      echo "=== Sessions ==="
      list_category "sessions"
    fi
    ;;

  session)
    [ -n "$2" ] || { echo "Usage: kb session <N>"; exit 1; }
    f=$(ls "$KB_DIR/sessions"/$2*.md 2>/dev/null | head -1)
    [ -f "$f" ] && cat "$f" || echo "Session $2 not found"
    ;;

  decisions)
    echo "=== Decisions ==="
    list_category "decisions"
    ;;

  bugs)
    echo "=== Bugs ==="
    if [ "$2" = "--open" ]; then
      for f in "$KB_DIR/bugs"/[0-9A-Z]*.md; do
        [ -f "$f" ] || continue
        [ "$(fm_val "$f" "status")" = "open" ] || continue
        printf "%-12s %-10s %-8s %s\n" "$(fm_val "$f" "id")" "$(fm_val "$f" "date")" "open" "$(fm_val "$f" "title")"
      done
    else
      list_category "bugs"
    fi
    ;;

  constraints)
    echo "=== Constraints ==="
    for f in "$KB_DIR/constraints"/*.md; do
      [ -f "$f" ] && [ "$(basename "$f")" != "INDEX.md" ] || continue
      echo "- $(fm_val "$f" "title") ($(basename "$f"))"
    done
    ;;

  dead-ends)
    echo "=== Dead Ends (Do Not Retry) ==="
    for f in "$KB_DIR/dead-ends"/*.md; do
      [ -f "$f" ] && [ "$(basename "$f")" != "INDEX.md" ] || continue
      echo "- $(fm_val "$f" "title") — $(fm_val "$f" "reason")"
    done
    ;;

  search)
    shift
    query="$*"
    echo "=== Search: $query ==="
    grep -rl "$query" "$KB_DIR"/ --include="*.md" 2>/dev/null | while read -r f; do
      rel=$(echo "$f" | sed "s|$KB_DIR/||")
      title=$(fm_val "$f" "title")
      [ -n "$title" ] && echo "  $rel — $title" || echo "  $rel"
    done
    ;;

  # === MAINTENANCE ===

  rebuild)
    echo "Rebuilding INDEX.md files..."
    gen_index "sessions" "Session Log"
    gen_index "decisions" "Decision Registry"
    gen_index "bugs" "Bug Tracker"
    {
      echo "# Project History"
      echo ""
      echo "- [\`sessions/\`](sessions/INDEX.md) — Chronological session logs"
      echo "- [\`decisions/\`](decisions/INDEX.md) — Architecture decision records"
      echo "- [\`bugs/\`](bugs/INDEX.md) — Bug reports and fixes"
      echo "- [\`constraints/\`](constraints/) — Environmental constraints"
      echo "- [\`dead-ends/\`](dead-ends/) — Failed approaches (do not retry)"
      echo ""
      echo "_Generated by \`kb rebuild\`._"
    } > "$KB_DIR/INDEX.md"
    echo "Done."
    ;;

  init)
    # Find git root
    GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")
    KB_DIR="$GIT_ROOT/docs/project-history"
    echo "Initializing knowledge base at: $KB_DIR"
    mkdir -p "$KB_DIR"/{sessions,decisions,bugs,constraints,dead-ends}
    # Copy this script into the project too for portability
    cp "$0" "$KB_DIR/kb" 2>/dev/null && chmod +x "$KB_DIR/kb" || true
    "$0" rebuild
    echo "Done. Knowledge base ready."
    ;;

  help|*)
    sed -n '2,25p' "$0"
    ;;
esac
