# Chezmoi ignore patterns - files that should not be managed by chezmoi.
#
# This repo is PUBLIC (github.com/wizardengineer/dotfiles). Anything matched here
# is never applied and is skipped by `chezmoi add`, so it doubles as the
# credential guard for `cadd`. Add to it before adding a new config tree.

# ---------------------------------------------------------------- credentials
# Live tokens. Never commit these.
.config/graphite/user_config          # Graphite authToken
.config/gh/hosts.yml                  # GitHub OAuth token
.pi/agent/auth.json                   # pi provider credentials
.pi/agent/models.json                 # contains a provider apiKey
.claude/settings.local.json           # machine-local permission grants
.claude/.credentials.json

# Neovim secrets and API keys
.config/nvim/lua/plugins/minuet-ai.lua

# Shell secrets
.zshrc.local

# --------------------------------------------------------------- machine-local
# Absolute paths / host-specific state that would break on another machine.
.pi/agent/trust.json
.config/atuin/atuin-receipt.json

# ------------------------------------------------------------- caches & state
# Regenerated by the tool; large, churny, or binary.
.pi/agent/git                         # ~443MB of cloned package repos
.pi/agent/npm
.pi/agent/sessions
.pi/agent/run-history.jsonl
.pi/agent/compound-engineering/legacy-backup
.config/zed/prompts                   # LMDB database, not text config
.config/opencode/node_modules
.config/opencode/cache
.config/nvim/brt_commands.db

# ----------------------------------------------------------------- editor cruft
**/.DS_Store
**/*.bak
**/*.backup
**/*.bck
.config/zed/settings.json.pre-deepseek
.config/nvim/lua/**/*.lua.backup
