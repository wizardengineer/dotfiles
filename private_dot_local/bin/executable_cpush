#!/usr/bin/env bash
# cpush -- CHEZMOI PUSH: publish the chezmoi source repo to its remote.
#
# Usage:
#   cpush         push the current branch
#   cpush -n      dry run: show what would be pushed

set -euo pipefail

DRY_RUN=0
while getopts "nh" opt; do
  case "$opt" in
    n) DRY_RUN=1 ;;
    h) sed -n '2,8p' "$0"; exit 0 ;;
    *) exit 2 ;;
  esac
done

command -v chezmoi >/dev/null || { echo "cpush: chezmoi not on PATH" >&2; exit 1; }

cd "$(chezmoi source-path)"

BRANCH="$(git rev-parse --abbrev-ref HEAD)"

# An uncommitted tree means `cadd` was never run, or was run and failed. Pushing
# would silently publish a stale snapshot, so stop and say so.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "cpush: uncommitted changes in $(pwd) -- run 'cadd' first:" >&2
  git status --short >&2
  exit 1
fi

if [[ $DRY_RUN -eq 1 ]]; then
  echo "==> would push branch '$BRANCH' to $(git remote get-url origin)"
  git --no-pager log --oneline @{upstream}..HEAD 2>/dev/null \
    || git --no-pager log --oneline -5
  exit 0
fi

# macOS ships bash 3.2, where an empty array under `set -u` is an error, so
# these stay as plain functions rather than an argument array.
do_push() {
  if git rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    git "$@" push
  else
    git "$@" push --set-upstream origin "$BRANCH"
  fi
}

# The osxkeychain helper does not always hold a github.com credential, which
# fails as "could not read Username for 'https://github.com'". `gh` is already
# authenticated, so fall back to its credential helper rather than leaving this
# to hang on an interactive prompt. Scoped to this invocation -- ~/.gitconfig is
# chezmoi-managed and should not pick up drift from a push.
ERR_LOG="$(mktemp -t cpush)"
trap 'rm -f "$ERR_LOG"' EXIT

if ! do_push 2>"$ERR_LOG"; then
  if grep -q "could not read Username" "$ERR_LOG" && command -v gh >/dev/null; then
    echo "cpush: keychain has no github.com credential, retrying via gh" >&2
    do_push -c "credential.helper=!gh auth git-credential"
  else
    cat "$ERR_LOG" >&2
    exit 1
  fi
fi

echo "cpush: pushed '$BRANCH' to $(git remote get-url origin)"
