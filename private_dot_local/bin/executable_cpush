#!/usr/bin/env bash
# cpush -- CHEZMOI PUSH: publish the chezmoi source repo to its remote.
#
# Usage:
#   cpush         push the current branch
#   cpush -n      dry run: show what would be pushed

set -euo pipefail

DRY_RUN=0
while getopts "nh" opt; do
  case "$opt" in
    n) DRY_RUN=1 ;;
    h) sed -n '2,8p' "$0"; exit 0 ;;
    *) exit 2 ;;
  esac
done

command -v chezmoi >/dev/null || { echo "cpush: chezmoi not on PATH" >&2; exit 1; }

cd "$(chezmoi source-path)"

BRANCH="$(git rev-parse --abbrev-ref HEAD)"

# An uncommitted tree means `cadd` was never run, or was run and failed. Pushing
# would silently publish a stale snapshot, so stop and say so.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "cpush: uncommitted changes in $(pwd) -- run 'cadd' first:" >&2
  git status --short >&2
  exit 1
fi

if [[ $DRY_RUN -eq 1 ]]; then
  echo "==> would push branch '$BRANCH' to $(git remote get-url origin)"
  git --no-pager log --oneline @{upstream}..HEAD 2>/dev/null \
    || git --no-pager log --oneline -5
  exit 0
fi

if git rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
  git push
else
  git push --set-upstream origin "$BRANCH"
fi

echo "cpush: pushed '$BRANCH' to $(git remote get-url origin)"
