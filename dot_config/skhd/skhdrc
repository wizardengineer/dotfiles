.define toggle_app : open -a "{{1}}" || osascript -e 'tell app "{{1}}" to quit'

cmd - return: open -a "kitty" 
cmd - b: @toggle_app("Google Chrome")
cmd + shift - return : @toggle_app("Zed")
cmd + shift - b: @toggle_app("Brave Browser")
cmd - g: @toggle_app("ChatGpt Classic")
cmd + shift - g: @toggle_app("Claude")
cmd - p: @toggle_app("Handy")
cmd - d: @toggle_app("Slack")
cmd - e : @toggle_app("Finder")
cmd - o : @toggle_app("Obsidian")
